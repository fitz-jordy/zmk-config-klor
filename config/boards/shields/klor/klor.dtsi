#include "klor_common.dtsi"

/ {
	chosen {
		zmk,matrix_transform = &default_transform;
	};

default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,2) RC(3,4) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
		>;
	};
};

physical_layout0: physical_layout_0 {
	compatible = "zmk,physical-layout";
	display-name = "KLOR Layout";
	transform = <&default_transform>;
	kscan = <&kscan0>;  

	keys  //                     w   h    x    y     rot    rx    ry
		= <&key_physical_attrs 100 100    0   90 (-1000)   200   325>
		, <&key_physical_attrs 100 100  100   90 (-1000)   200   325>
		, <&key_physical_attrs 100 100  200   25  (-400)   275   325>
		, <&key_physical_attrs 100 100  300    0       0     0     0>
		, <&key_physical_attrs 100 100  400   25       0     0     0>
		, <&key_physical_attrs 100 100  500   50       0     0     0>
		, <&key_physical_attrs 100 100 1100   50       0     0     0>
		, <&key_physical_attrs 100 100 1200   25       0     0     0>
		, <&key_physical_attrs 100 100 1300    0       0     0     0>
		, <&key_physical_attrs 100 100 1400   25     400  1450   325>
		, <&key_physical_attrs 100 100 1500   90    1000  1525   325>
		, <&key_physical_attrs 100 100 1600   90    1000  1525   325>
		, <&key_physical_attrs 100 100    0  190 (-1000)   200   325>
		, <&key_physical_attrs 100 100  100  190 (-1000)   200   325>
		, <&key_physical_attrs 100 100  200  125  (-400)   275   325>
		, <&key_physical_attrs 100 100  300  100       0     0     0>
		, <&key_physical_attrs 100 100  400  125       0     0     0>
		, <&key_physical_attrs 100 100  500  150       0     0     0>
		, <&key_physical_attrs 100 100 1100  150       0     0     0>
		, <&key_physical_attrs 100 100 1200  125       0     0     0>
		, <&key_physical_attrs 100 100 1300  100       0     0     0>
		, <&key_physical_attrs 100 100 1400  125     400  1450   325>
		, <&key_physical_attrs 100 100 1500  190    1000  1525   325>
		, <&key_physical_attrs 100 100 1600  190    1000  1525   325>
		, <&key_physical_attrs 100 100    0  290 (-1000)   200   325>
		, <&key_physical_attrs 100 100  100  290 (-1000)   200   325>
		, <&key_physical_attrs 100 100  200  225  (-400)   275   325>
		, <&key_physical_attrs 100 100  300  200       0     0     0>
		, <&key_physical_attrs 100 100  400  225       0     0     0>
		, <&key_physical_attrs 100 100  500  250       0     0     0>
		, <&key_physical_attrs 100 100 1100  250       0     0     0>
		, <&key_physical_attrs 100 100 1200  225       0     0     0>
		, <&key_physical_attrs 100 100 1300  200       0     0     0>
		, <&key_physical_attrs 100 100 1400  225     400  1450   325>
		, <&key_physical_attrs 100 100 1500  290    1000  1525   325>
		, <&key_physical_attrs 100 100 1600  290    1000  1525   325>
		, <&key_physical_attrs 100 100  350  340       0     0     0>
		, <&key_physical_attrs 100 100  350  340    1500   400   810>
		, <&key_physical_attrs 100 100  350  340    3000   400   810>
		, <&key_physical_attrs 100 100  350  340    4500   400   810>
		, <&key_physical_attrs 100 100 1250  340 (-4500)  1300   810>
		, <&key_physical_attrs 100 100 1250  340 (-3000)  1300   810>
		, <&key_physical_attrs 100 100 1250  340 (-1500)  1300   810>
		, <&key_physical_attrs 100 100 1250  340       0     0     0>
		;
};

&kscan0 {
	row-gpios
		= <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};

&left_encoder {
	a-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	b-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
};

&right_encoder {
	a-gpios = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
};